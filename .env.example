# Neon connection string, read by the app and by pnpm db:migrate.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# goldapi.io API key, read by the daily job.
GOLD_API_KEY=goldapi-example-key

# Commit SHA that next build inlines into /health. CI and the deploy workflow set it.
COMMIT_SHA=0000000000000000000000000000000000000000

# PLAYWRIGHT_BASE_URL runs pnpm test:e2e against that URL instead of next start.
# Leave it unset locally; the deploy workflow sets it to the production URL.
